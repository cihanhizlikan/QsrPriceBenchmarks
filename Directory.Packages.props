<Project>
  <!-- Central package management (adopted from Yalbuz 2026-11-07). EVERY package version in the repository is stated
       here and nowhere else; a project names a package and never a version — a Version on a PackageReference is
       NU1008, an error. Before this, three references FLOATED (Microsoft.Data.Sqlite.Core 10.0.*,
       SQLitePCLRaw.bundle_winsqlite3 2.1.*, xunit 2.*), so what the MSI carried depended on the day of the restore.
       Each was pinned at the version it resolved to then, so the pin changed no build output.

       THE RULE FOR A BUMP: a patch or minor is taken freely; a MAJOR is a decision, not a bump. The two SQLitePCLRaw
       bundles below are different packages, chosen per host (settled-decisions.md, SQLite provider), but they MUST
       share one SQLitePCLRaw.core major: Tests references both (Cli brings the hosts' bundle in), so a 3.x test
       bundle drags core to 3.x under Microsoft.Data.Sqlite (built against core 2.1) and the hosts' 2.1 provider.
       bundle_winsqlite3 has no 3.x, so the test bundle stays on 2.1 until it does (plan WP-T3, 2026-11-07) — at
       2.1.14 or later: lib.e_sqlite3 2.1.11 and below carry advisory GHSA-2m69-gcr7-jv3q (High). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Shipped: Core and the two hosts. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="AngleSharp" Version="1.10.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <!-- The Windows apps' SQLite provider: the SQLite that ships with Windows. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
  </ItemGroup>

  <!-- Build-time only: analyzers and the installer's WiX extension. -->
  <ItemGroup>
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <!-- Tests. -->
  <ItemGroup>
    <!-- The test host's SQLite provider: cross-platform native SQLite, so the hermetic tests run anywhere. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <!-- Both test projects run on Microsoft Testing Platform (global.json's "test" section), so VSTest's adapter
         and Microsoft.NET.Test.Sdk are gone. Coverage comes from Microsoft's own MTP extension
         (the command is in .claude/skills/wp-verify/SKILL.md). -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
</Project>
