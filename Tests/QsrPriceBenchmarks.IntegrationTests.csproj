<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\QsrPriceBenchmarks.Core.csproj" />
    <!-- Referenced so the CLI argument parser can be tested directly. -->
    <ProjectReference Include="..\Cli\QsrPriceBenchmarks.Cli.csproj" />
    <!-- The test host's SQLite provider: cross-platform native SQLite, so the
         hermetic DB / view / export tests run on Linux CI and any dev box.
         (The shipping apps use provider.winsqlite3; Core is provider-agnostic.) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
