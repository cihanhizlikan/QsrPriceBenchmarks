<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QsrPriceBenchmarks.Ui.Dialogs.ThemedMessageBox"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg2}"
        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- The app's message box: WPF cannot style System.Windows.MessageBox, which
       Windows draws itself, so this window replaces it. Colours and buttons are
       the theme's (Ui/Themes/Dark.xaml); nothing here defines a colour. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title bar: the window has no system chrome, so this is where it is dragged. -->
    <Border Grid.Row="0" Background="{StaticResource BrushBgChrome}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0 0 0 1"
            Padding="16 10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <TextBlock x:Name="CaptionText" Foreground="{StaticResource BrushLightCyan}"
                 FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
    </Border>

    <!-- Icon and message -->
    <Grid Grid.Row="1" Margin="20 18 24 18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="IconGlyph" Grid.Column="0" FontSize="22" FontWeight="Bold"
                 Margin="0 -2 14 0" VerticalAlignment="Top"/>
      <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap"
                 Foreground="{StaticResource BrushText}" FontSize="13" LineHeight="19"
                 VerticalAlignment="Center"/>
    </Grid>

    <!-- Buttons, right-aligned on a darker strip like the main window's panels. -->
    <Border Grid.Row="2" Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0 1 0 0" Padding="16 12">
      <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right"/>
    </Border>
  </Grid>
</Window>
