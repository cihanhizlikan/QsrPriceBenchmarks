<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── Colour palette matching cmd.exe (legacy conhost) default scheme ────
         The CLI prints ANSI codes; cmd.exe renders them with these exact RGB
         values. The in-app log colouriser renders ANSI 2;96 (dim cyan) as a
         genuinely dimmer cyan, so ColorDimCyan matches it (#00B3B3) — used for
         secondary cyan (hover, selection, separators, the logo's dim bars).
         A separate ColorChromeCyan is used for UI chrome (tab underline, button
         accents) so the app furniture stays visually layered. -->
    <Color x:Key="ColorBg">#1A1A1A</Color>
    <Color x:Key="ColorBg2">#252525</Color>
    <Color x:Key="ColorBg3">#1C1C1C</Color>           <!-- ANSI 48;5;234 step/widget bg -->
    <Color x:Key="ColorBorder">#3A3A3A</Color>
    <Color x:Key="ColorLightCyan">#00FFFF</Color>     <!-- ANSI 96   bright cyan -->
    <Color x:Key="ColorDimCyan">#00B3B3</Color>       <!-- ANSI 2;96 dimmed cyan -->
    <Color x:Key="ColorText">#FFFFFF</Color>          <!-- ANSI 97  bright white -->
    <Color x:Key="ColorTextDim">#9E9E9E</Color>
    <Color x:Key="ColorAccentBg">#004D5C</Color>
    <Color x:Key="ColorSelected">#00838F</Color>
    <Color x:Key="ColorDanger">#C62828</Color>
    <Color x:Key="ColorPurple">#FF00FF</Color>        <!-- ANSI 95  bright magenta -->
    <Color x:Key="ColorChromeCyan">#33C4CC</Color>    <!-- UI furniture only, not log text -->
    <Color x:Key="ColorBgChrome">#111111</Color>      <!-- header bar and chain sidebar -->
    <Color x:Key="ColorToolTipBg">#202020</Color>
    <!-- Map provinces: translucent cyan, stronger where the chain has locations. -->
    <Color x:Key="ColorMapFill">#1A00B3B3</Color>
    <Color x:Key="ColorMapStroke">#8000B3B3</Color>
    <Color x:Key="ColorMapFillActive">#3D00FFFF</Color>
    <Color x:Key="ColorMapFillHover">#6000FFFF</Color>

    <SolidColorBrush x:Key="BrushBg"        Color="{StaticResource ColorBg}"/>
    <SolidColorBrush x:Key="BrushBg2"       Color="{StaticResource ColorBg2}"/>
    <SolidColorBrush x:Key="BrushBg3"       Color="{StaticResource ColorBg3}"/>
    <SolidColorBrush x:Key="BrushBorder"    Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushLightCyan" Color="{StaticResource ColorLightCyan}"/>
    <SolidColorBrush x:Key="BrushDimCyan"   Color="{StaticResource ColorDimCyan}"/>
    <SolidColorBrush x:Key="BrushText"      Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="BrushTextDim"   Color="{StaticResource ColorTextDim}"/>
    <SolidColorBrush x:Key="BrushAccentBg"  Color="{StaticResource ColorAccentBg}"/>
    <SolidColorBrush x:Key="BrushSelected"  Color="{StaticResource ColorSelected}"/>
    <SolidColorBrush x:Key="BrushDanger"    Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushPurple"    Color="{StaticResource ColorPurple}"/>
    <SolidColorBrush x:Key="BrushChromeCyan" Color="{StaticResource ColorChromeCyan}"/>
    <SolidColorBrush x:Key="BrushBgChrome"  Color="{StaticResource ColorBgChrome}"/>
    <SolidColorBrush x:Key="BrushToolTipBg" Color="{StaticResource ColorToolTipBg}"/>
    <SolidColorBrush x:Key="BrushMapFill"       Color="{StaticResource ColorMapFill}"/>
    <SolidColorBrush x:Key="BrushMapStroke"     Color="{StaticResource ColorMapStroke}"/>
    <SolidColorBrush x:Key="BrushMapFillActive" Color="{StaticResource ColorMapFillActive}"/>
    <SolidColorBrush x:Key="BrushMapFillHover"  Color="{StaticResource ColorMapFillHover}"/>

    <!-- ── Base control styles ─────────────────────────────────────────────── -->
    <!-- No implicit Window style: WPF applies implicit styles by exact type, so one
         keyed to Window never reaches MainWindow (a subclass). Measured 2026-10-25:
         MainWindow.Style null, FontSize 12, Background white - the one this file
         carried described a window that does not exist. The window's look comes
         from MainWindow.xaml's own root panels and the control styles below. -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background"  Value="{StaticResource BrushBg3}"/>
        <Setter Property="Foreground"  Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"     Value="6 4"/>
        <Setter Property="CaretBrush"  Value="{StaticResource BrushLightCyan}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BrushDimCyan}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Standard button -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource BrushBg3}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"      Value="14 6"/>
        <Setter Property="MinHeight"    Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="FontFamily"   Value="Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccentBg}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushDimCyan}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushSelected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>

    <!-- Run button — prominent cyan accent -->
    <Style x:Key="ButtonRun" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background"   Value="{StaticResource BrushAccentBg}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushLightCyan}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushLightCyan}"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Padding"      Value="16 6"/>
    </Style>

    <!-- Danger button — delete actions -->
    <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background"  Value="#3B0000"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
        <Setter Property="Foreground"  Value="{StaticResource BrushDanger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TabControl — fully retemplated so the header strip uses the dark
         window background (the default template paints it white/system colour)
         and the tab headers render as rounded pill buttons like the rest of
         the app. -->
    <Style TargetType="TabControl">
        <Setter Property="Background"   Value="{StaticResource BrushBg}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{StaticResource BrushBg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Header strip: dark, with a baseline the tabs sit on -->
                        <Border Grid.Row="0" Background="{StaticResource BrushBg}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0 0 0 1"
                                Padding="16 6 16 0">
                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                        </Border>
                        <!-- Content area -->
                        <Border Grid.Row="1" Background="{StaticResource BrushBg}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background"    Value="{StaticResource BrushBg3}"/>
        <Setter Property="Foreground"    Value="{StaticResource BrushText}"/>
        <Setter Property="Padding"       Value="16 7"/>
        <Setter Property="Margin"        Value="0 0 6 0"/>
        <Setter Property="FontFamily"    Value="Segoe UI"/>
        <Setter Property="FontSize"      Value="13"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- Outlined tab handle: a visible border with a rounded top
                         and open bottom, so it sits on the strip's baseline and
                         reads as a tab (not a free-floating pill button). -->
                    <Border Name="Tab" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1 1 1 0" CornerRadius="6 6 0 0"
                            Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource BrushDimCyan}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushLightCyan}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="Background"  Value="{StaticResource BrushAccentBg}"/>
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource BrushLightCyan}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushLightCyan}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"          Value="{StaticResource BrushBg2}"/>
        <Setter Property="Foreground"          Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush"         Value="{StaticResource BrushBorder}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="VerticalGridLinesBrush"   Value="{StaticResource BrushBorder}"/>
        <Setter Property="RowBackground"       Value="{StaticResource BrushBg2}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BrushBg3}"/>
        <Setter Property="SelectionMode"       Value="Single"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows"      Value="False"/>
        <Setter Property="MinRowHeight"        Value="34"/>
        <Setter Property="FontFamily"          Value="Consolas"/>
        <!-- Column headers only: the default (All) also draws a row-header column
             and corner that nothing here styles, which rendered as a light strip
             down the left of every grid. Selection is shown by the cell highlight. -->
        <Setter Property="HeadersVisibility"   Value="Column"/>
    </Style>

    <!-- Sort arrow beside a column's title: ▲ ascending, ▼ descending, nothing while another column sorts. It
         reads the header it sits in, so it serves both a plain title and a filter header (ColumnFilterHeader). -->
    <Style x:Key="SortArrow" TargetType="Path">
        <Setter Property="Fill"              Value="{StaticResource BrushLightCyan}"/>
        <Setter Property="Margin"            Value="6 0 0 0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility"        Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}"
                         Value="Ascending">
                <Setter Property="Data"       Value="M0,5 L4,0 L8,5 Z"/>
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}"
                         Value="Descending">
                <Setter Property="Data"       Value="M0,0 L8,0 L4,5 Z"/>
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The resize grip on each side of a header: invisible, a resize cursor -->
    <Style x:Key="HeaderGripper" TargetType="Thumb">
        <Setter Property="Width"      Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor"     Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A header of its own, not WPF's: the stock one draws its sort arrow as a grey sliver along the top edge,
         invisible on this background. A plain title gets the arrow from the string template below — implicit, not
         ContentTemplate, which a header whose content is an element (the filter headers, which carry the arrow
         themselves) would also take, showing the element's type name. -->
    <Style TargetType="DataGridColumnHeader">
        <Style.Resources>
            <DataTemplate DataType="{x:Type sys:String}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    <Path Style="{StaticResource SortArrow}"/>
                </StackPanel>
            </DataTemplate>
        </Style.Resources>
        <Setter Property="Background"  Value="{StaticResource BrushBg3}"/>
        <Setter Property="Foreground"  Value="{StaticResource BrushLightCyan}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="0 0 1 1"/>
        <Setter Property="Padding"     Value="10 6"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper"  HorizontalAlignment="Left"  Style="{StaticResource HeaderGripper}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource HeaderGripper}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground"               Value="{StaticResource BrushText}"/>
        <Setter Property="BorderThickness"          Value="0"/>
        <Setter Property="Padding"                  Value="10 6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#3F3F3F"/>
                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Cell text: vertically centred with a left indent so values don't sit
         flush against the column edge. -->
    <Style x:Key="GridCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10 0 0 0"/>
    </Style>

    <!-- Scroll bars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource BrushBg2}"/>
        <Setter Property="Width" Value="8"/>
    </Style>

    <!-- Column filter funnel (Scrape Runs headers): dim until hovered, highlighted while its filter hides rows -->
    <Style x:Key="FilterToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- A drawn funnel, not an icon-font glyph: the implicit TextBlock style above would set the
                     glyph's text in Segoe UI, which has no funnel -->
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="4 3">
                        <Path Data="M0,0 L10,0 L6,5 L6,10 L4,9 L4,5 Z" Fill="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushLightCyan}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushLightCyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"  Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="Margin"      Value="0 0 0 4"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Label -->
    <Style TargetType="Label">
        <Setter Property="Foreground"  Value="{StaticResource BrushTextDim}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="Padding"     Value="0 0 0 2"/>
    </Style>

    <!-- Separator -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
        <Setter Property="Margin"     Value="0 8"/>
    </Style>

    <!-- Progress bar: rounded track + cyan gradient fill that gently pulses -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height"          Value="12"/>
        <Setter Property="Background"      Value="{StaticResource BrushBg3}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Border Name="PART_Track"/>
                            <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource ColorChromeCyan}" Offset="0"/>
                                        <GradientStop Color="{StaticResource ColorLightCyan}"  Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- A subtle, slow opacity pulse gives the fill some life.
                             No Storyboard.TargetName: inside ControlTemplate.Triggers
                             a name-less target animates the templated ProgressBar
                             itself. Targeting "PART_Indicator" by name here throws
                             'name cannot be found in namescope' on Loaded and crashes
                             startup, so we animate the control's own Opacity instead. -->
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.6" To="1.0" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
